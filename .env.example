# ── Supabase (projet dédié à la plateforme, PAS celui de l'appli interne) ──
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role : SERVEUR UNIQUEMENT (création des comptes élèves). Ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://ideaforma.fr

# ── E-mails (Resend) ──
# Sans clé : le mot de passe de l'élève est affiché à l'admin pour transmission manuelle.
RESEND_API_KEY=re_...
# Tant qu'aucun domaine n'est vérifié chez Resend, seul onboarding@resend.dev fonctionne
# (et uniquement vers l'adresse du compte Resend). Après vérification du domaine : contact@ideaforma.fr
MAIL_FROM="IDEAFORMA <onboarding@resend.dev>"
# Adresse qui reçoit les demandes du formulaire de contact
CONTACT_TO=contact.ideaforma@gmail.com
